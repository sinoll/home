<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Home" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.Home.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Home.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Home.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- 登录/注册/找回密码：Bridge 主题保留 AppCompat 行为，同时启用 Material 输入框 -->
    <style name="Theme.Home.Auth" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="colorControlActivated">@color/brand_primary</item>
        <item name="android:windowBackground">@color/auth_page_bg</item>
        <item name="android:statusBarColor">@color/auth_page_bg</item>
        <item name="android:navigationBarColor">@color/auth_page_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="AuthTitle">
        <item name="android:textColor">@color/ink_strong</item>
        <item name="android:textSize">@dimen/auth_title_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AuthSubtitle">
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="AuthField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/auth_field_spacing</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/brand_primary</item>
        <item name="android:textColorHint">@color/ink_faint</item>
        <item name="errorTextColor">@color/field_error</item>
        <item name="errorIconDrawable">@null</item>
        <item name="errorTextAppearance">@style/AuthFieldError</item>
        <item name="startIconTint">@color/brand_primary</item>
    </style>

    <style name="AuthFieldError" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/field_error</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="AuthInput" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/ink_strong</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:inputType">text</item>
    </style>

    <style name="AuthCta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/auth_button_height</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:background">@drawable/btn_auth_primary</item>
        <item name="android:textColor">@color/brand_on_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="AuthLink">
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:padding">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="AuthRule">
        <item name="android:textColor">@color/ink_faint</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
</resources>
