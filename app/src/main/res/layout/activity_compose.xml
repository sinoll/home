<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingTop="6dp"
        android:paddingRight="16dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/ink_muted" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_compose"
            android:textColor="@color/ink_strong"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="10dp"
            android:text="@string/action_delete"
            android:textColor="@color/field_error"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/input_stroke" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="14dp"
            android:paddingRight="16dp"
            android:paddingBottom="20dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/typeRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <EditText
                android:id="@+id/titleInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_compose_title"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="120"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/ink_body"
                android:textColorHint="@color/ink_faint"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="@string/hint_compose_moment"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:lineSpacingExtra="4dp"
                android:minHeight="150dp"
                android:padding="12dp"
                android:textColor="@color/ink_body"
                android:textColorHint="@color/ink_faint"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/picsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/picsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_compose_pics"
                    android:textColor="@color/ink_strong"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/picsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/ink_faint"
                    android:textSize="12sp" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="3" />

            <LinearLayout
                android:id="@+id/videoSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnVideoPick"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/btn_compose_ghost"
                        android:drawableStart="@drawable/ic_menu_gallery"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/brand_primary"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="@string/action_video_pick"
                        android:textColor="@color/brand_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnVideoRecord"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/btn_compose_ghost"
                        android:drawableStart="@drawable/ic_video_record"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/brand_primary"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="@string/action_video_record"
                        android:textColor="@color/brand_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/videoInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/ink_faint"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/coverSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/coverImage"
                    android:layout_width="120dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_input"
                    android:contentDescription="@string/label_compose_cover"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/btnCoverPick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_compose_ghost"
                    android:paddingLeft="14dp"
                    android:paddingTop="9dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="9dp"
                    android:text="@string/action_cover_pick"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/coverHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="@color/ink_faint"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cateSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_compose_cate"
                    android:textColor="@color/ink_strong"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/cateRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:progressTint="@color/brand_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ink_faint"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_visibility"
                android:textColor="@color/ink_strong"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/visibilityRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/topicHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/compose_hint_topic"
                android:textColor="@color/ink_faint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/mentionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/compose_hint_mention"
                android:textColor="@color/ink_faint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/field_error"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/input_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnDraft"
            android:layout_width="0dp"
            android:layout_height="@dimen/auth_button_height"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn_compose_ghost"
            android:gravity="center"
            android:text="@string/action_draft"
            android:textColor="@color/brand_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnPublish"
            android:layout_width="0dp"
            android:layout_height="@dimen/auth_button_height"
            android:layout_weight="1.4"
            android:background="@drawable/btn_auth_primary"
            android:gravity="center"
            android:text="@string/action_publish"
            android:textColor="@color/brand_on_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
