<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_header_height"
    android:background="@drawable/side_nav_bar"
    android:orientation="vertical"
    android:paddingLeft="@dimen/nav_header_padding_horizontal"
    android:paddingTop="@dimen/nav_header_padding_top"
    android:paddingRight="@dimen/nav_header_padding_horizontal"
    android:paddingBottom="18dp">

    <FrameLayout
        android:id="@+id/avatar_wrap"
        android:layout_width="@dimen/nav_avatar_ring"
        android:layout_height="@dimen/nav_avatar_ring"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_avatar_ring">

        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/nav_avatar_size"
            android:layout_height="@dimen/nav_avatar_size"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_placeholder"
            android:contentDescription="@string/nav_user_head"
            android:padding="14dp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ic_field_person" />

        <TextView
            android:id="@+id/tv_avatar_initial"
            android:layout_width="@dimen/nav_avatar_size"
            android:layout_height="@dimen/nav_avatar_size"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_placeholder"
            android:gravity="center"
            android:textColor="@color/brand_on_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/nav_user_name"
        android:textColor="@color/brand_on_primary"
        android:textSize="@dimen/nav_username_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_useremail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/nav_user_email"
        android:textColor="@color/brand_on_primary_muted"
        android:textSize="@dimen/nav_usermeta_size" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/btn_auth_primary"
        android:stateListAnimator="@null"
        android:text="@string/btn_auth_cta"
        android:textAllCaps="false"
        android:textColor="@color/brand_on_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/logged_in_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/btn_auth_ghost"
            android:stateListAnimator="@null"
            android:text="@string/btn_logout"
            android:textAllCaps="false"
            android:textColor="@color/brand_on_primary_muted"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
