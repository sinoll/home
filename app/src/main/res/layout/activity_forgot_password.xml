<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_page_bg">

    <View
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-150dp"
        android:layout_marginEnd="-120dp"
        android:background="@drawable/bg_auth_glow" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/auth_padding_horizontal"
            android:paddingTop="8dp"
            android:paddingRight="@dimen/auth_padding_horizontal"
            android:paddingBottom="36dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ink_muted" />

            <TextView
                style="@style/AuthTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/title_reset" />

            <TextView
                style="@style/AuthSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/subtitle_reset" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_email"
                    style="@style/AuthField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:hint="@string/hint_email"
                    app:startIconDrawable="@drawable/ic_field_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_email"
                        style="@style/AuthInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tv_send_code"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_code_button"
                    android:gravity="center"
                    android:minWidth="104dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/action_send_code"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_code"
                style="@style/AuthField"
                android:hint="@string/hint_code"
                app:startIconDrawable="@drawable/ic_field_code">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_code"
                    style="@style/AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLength="6" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                style="@style/AuthField"
                android:hint="@string/hint_new_password"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_field_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    style="@style/AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/AuthRule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_password_rule" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_confirm"
                style="@style/AuthField"
                android:hint="@string/hint_confirm_password"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_field_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_confirm"
                    style="@style/AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btn_submit"
                    style="@style/AuthCta"
                    android:text="@string/action_reset" />

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="24dp"
                    android:indeterminateTint="@color/brand_on_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_go_login"
                style="@style/AuthLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="@string/link_go_login" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
