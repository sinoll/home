<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.sinoll.home.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_search"
        android:name="com.sinoll.home.ui.search.SearchFragment"
        android:label="@string/menu_search"
        tools:layout="@layout/fragment_search">

        <argument
            android:name="q"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/nav_gallery"
        android:name="com.sinoll.home.ui.gallery.GalleryFragment"
        android:label="@string/menu_gallery"
        tools:layout="@layout/fragment_gallery" />

    <fragment
        android:id="@+id/nav_messages"
        android:name="com.sinoll.home.ui.messages.MessagesFragment"
        android:label="@string/action_messages"
        tools:layout="@layout/fragment_messages" />

    <fragment
        android:id="@+id/nav_mine"
        android:name="com.sinoll.home.ui.mine.MineFragment"
        android:label="@string/menu_mine"
        tools:layout="@layout/fragment_mine" />
</navigation>